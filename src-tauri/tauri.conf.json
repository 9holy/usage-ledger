{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "用量账本",
  "version": "0.2.25",
  "identifier": "com.console.2api",
  "build": {
    "beforeDevCommand": "pnpm dev --port 5180 --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "focus": false,
        "title": "用量账本",
        "url": "index.html#/connect",
        "width": 1600,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "用量账本"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MTNGNTAxMzlFMzRBMzkKUldRNVN1TTVBZlVUeUpYRjA2MzdOcmY3eEFta08xTlhTaTVLb1pocXNJdFpJdXBzUXlUdU1BTU0K",
      "endpoints": [
        "https://github.com/9holy/usage-ledger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
