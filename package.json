{
  "name": "sub2api-frontend",
  "private": true,
  "version": "0.2.51",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.9 <10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "vue-tsc -b && vite build --mode desktop",
    "preview": "vite preview",
    "desktop:dev": "node scripts/desktop-command.mjs dev",
    "desktop:build": "node scripts/desktop-command.mjs build",
    "desktop:build:mac": "node scripts/build-macos.mjs",
    "desktop:test:mac": "node scripts/test-macos.mjs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:headless": "python scripts/test-native-headless.py",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.30.2",
    "@lucide/vue": "^1.28.0",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.21.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.17",
    "driver.js": "^1.4.0",
    "file-saver": "^2.0.5",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "three": "0.186.1",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@intlify/message-compiler": "11.4.18",
    "@tauri-apps/cli": "^2.12.4",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^6.4.5",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "4.1.12",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": "3.0.7",
      "form-data@<4.0.6": ">=4.0.6",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.18": ">=8.5.18",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "browserslist@<4.28.7": "4.28.7",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "flatted@<3.4.2": "3.4.2",
      "follow-redirects@<1.16.2": "1.16.2",
      "glob@>=9 <14.0.2": "14.0.4",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "lodash@<4.18.0": "4.18.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=7 <11.0.1": "11.0.5",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "rollup@>=4 <4.59.0": "4.59.0",
      "source-map-js@<1.2.2": "1.2.2",
      "ws@>=8 <8.21.0": "8.21.0",
      "yaml@<1.10.3": "1.10.3"
    }
  }
}
